# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は絶対にGitへコミットしないこと（.gitignoreで除外済み）。

# Apify (Instagramデータ取得)
APIFY_API_TOKEN=

# Anthropic Claude API (AI分析・企画生成)
ANTHROPIC_API_KEY=

# Supabase (データベース)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (分析結果の出力先)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/google-service-account.json
GOOGLE_SPREADSHEET_ID=
